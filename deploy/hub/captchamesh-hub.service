[Unit]
Description=CaptchaMesh authenticated registration relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=captchamesh
Group=captchamesh
WorkingDirectory=/opt/captchamesh-hub
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CAPTCHAMESH_DB_PATH=/var/lib/captchamesh-hub/broker.db
Environment=CAPTCHAMESH_REGISTRY_PATH=/opt/captchamesh-hub/registrations.json
Environment=CAPTCHAMESH_API_KEY_FILE=/etc/captchamesh-hub/api.key
Environment=CAPTCHAMESH_NODE_KEY_FILE=/etc/captchamesh-hub/node.key
Environment=CAPTCHAMESH_ALLOW_PUBLIC_PAIRING=1
EnvironmentFile=/etc/captchamesh-hub/hub.env
ExecStart=/opt/captchamesh-hub/.venv/bin/hypercorn --bind 127.0.0.1:8890 --workers 1 --backlog 128 --keep-alive 5 --max-requests 10000 --max-requests-jitter 1000 --graceful-timeout 15 broker_asgi:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/captchamesh-hub
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
